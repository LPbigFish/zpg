{
  "cmake.generator": "Ninja",
  "cmake.configurePreset": "dev",
  "cmake.buildBeforeRun": true,
  "cmake.buildEnvironment": {
    "CC": "clang",
    "CXX": "clang++"
  },
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--compile-commands-dir=${workspaceFolder}/build/dev",
    "--query-driver=/nix/store/*-clang-wrapper-*/bin/clang++,/nix/store/*-clang-*/bin/clang++"
  ]
}
